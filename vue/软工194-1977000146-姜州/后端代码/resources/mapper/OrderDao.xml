<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zhou.deliverysystem.dao.OrderDao">
    <select id="getMyOrderByStatus" resultType="com.zhou.deliverysystem.enenty.Order">
        SELECT
            *
        FROM
            `order`
        WHERE user_id=#{userId} and status in
              <foreach collection="status" item="i" index="index" open="(" separator="," close=")">
              #{i}
              </foreach>
    </select>
</mapper>